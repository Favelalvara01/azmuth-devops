# Copia este archivo como ".env" (sin el ".example") y llena tus claves reales.
# El archivo .env NUNCA se comparte ni se sube a internet.

ANTHROPIC_API_KEY=tu_clave_de_anthropic_aqui
ELEVENLABS_API_KEY=tu_clave_de_elevenlabs_aqui
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
PALABRA_CLAVE=hora de ser heroe

# Puerto único: aquí vive la interfaz gráfica Y el servidor de comandos
# remotos (el que tunelea Ngrok). No lo cambies a menos que ese puerto
# ya esté ocupado por otra cosa en tu compu.
PUERTO_SERVIDOR=8080

# Ngrok — para seguir controlando Azmuth desde el reloj o el celular
# fuera de tu red local. Consíguelo gratis en dashboard.ngrok.com
# (Your Authtoken). Si lo dejas vacío, Azmuth arranca igual pero solo
# con control local (sin acceso remoto).
NGROK_AUTHTOKEN=tu_token_de_ngrok_aqui
# Dominio fijo reservado en tu cuenta de Ngrok (Domains → New Domain).
# Déjalo vacío si prefieres que te asigne uno aleatorio cada vez.
NGROK_DOMINIO=tu-dominio-fijo.ngrok-free.dev

# Opcional: protege el control remoto (celular/reloj por Ngrok). Inventa una clave larga.
TOKEN_REMOTO=

# Palabra clave cuando Azmuth esta en ingles (opcional)
PALABRA_CLAVE_EN=it's hero time
